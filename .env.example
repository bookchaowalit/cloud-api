# Cloud API binds to loopback by default.
CLOUD_API_HOST=127.0.0.1
CLOUD_API_PORT=3440
CLOUD_API_CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Leave empty for local loopback development. Required for a non-loopback bind.
# CLOUD_API_TOKEN=

# Optional: development/staging label only; it does not enable writes.
CLOUD_API_ENV=development
